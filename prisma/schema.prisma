generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("INKFLOW_DATABASE_URL")
  directUrl = env("INKFLOW_DATABASE_URL_UNPOOLED")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String?
  name               String?
  credits            Int                 @default(5)
  plan               String              @default("free")
  role               String              @default("user")
  subscriptionEnd    DateTime?
  stripeCustomerId   String?             @unique
  emailVerifiedAt    DateTime?
  aiTuneUseCount     Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  transactions       CreditTransaction[]
  purchases          CreditPurchase[]
  signatures         SavedSignature[]
  templateUnlocks    TemplateUnlock[]
  signAudits         SignAudit[]
  signedDocuments    SignedDocument[]
  payContracts       PayContract[]
  subscriptionRecords SubscriptionRecord[]
  passwordResetTokens PasswordResetToken[]
  mobileRefreshTokens MobileRefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  loginEvents        LoginEvent[]
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    String   @default("web")
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model MobileRefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model TemplateUnlock {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseId    String
  createdAt DateTime @default(now())

  @@unique([userId, baseId])
  @@index([userId])
}

model SavedSignature {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  strokeData String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, createdAt])
}

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  createdAt DateTime @default(now())
}

model CreditPurchase {
  id                    String        @id @default(cuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentProvider       String        @default("stripe")
  stripeSessionId       String        @unique
  stripePaymentIntentId String?
  appleTransactionId    String?       @unique
  appleOriginalTransactionId String?
  googlePurchaseToken   String?       @unique
  googleOrderId         String?
  packId                String?
  purchaseType          String        @default("credits")
  credits               Int
  amountCents           Int
  currency              String        @default("usd")
  status                String        @default("pending")
  refundedCents         Int           @default(0)
  paidAt                DateTime?
  expiresAt             DateTime?
  contractId            String?
  contract              PayContract?  @relation(fields: [contractId], references: [id], onDelete: SetNull)
  refunds               RefundOrder[]
  createdAt             DateTime      @default(now())

  @@index([userId, createdAt])
}

model PayContract {
  id                   String           @id @default(cuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planCode             String           @default("pro_monthly")
  stripeCustomerId     String?
  stripeSubscriptionId String?          @unique
  status               String           @default("pending")
  nextChargeAt         DateTime?
  lastChargeAt         DateTime?
  failedCount          Int              @default(0)
  purchases            CreditPurchase[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([userId, status])
}

model SubscriptionRecord {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan             String
  creditsGranted   Int      @default(0)
  periodEnd        DateTime?
  sourcePurchaseId String?
  contractId       String?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

model RefundOrder {
  id               String         @id @default(cuid())
  purchaseId       String
  purchase         CreditPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  amountCents      Int
  creditsClawedBack Int           @default(0)
  status           String         @default("pending")
  reason           String?
  stripeRefundId   String?
  operatorId       String?
  createdAt        DateTime       @default(now())
}

model SignAudit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName  String
  level     String   @default("SES")
  pageCount Int      @default(1)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// An admin-uploaded AI signature style. The reference image lives in `image`
/// (client-downscaled before upload) and doubles as the picker thumbnail and
/// the fal style-reference. Built-in styles stay in `lib/ai-photo-styles.ts`.
model AiStyleAsset {
  id        String   @id @default(cuid())
  name      String
  blurb     String   @default("")
  prompt    String
  mimeType  String
  image     Bytes
  byteSize  Int
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

/// An admin-uploaded signature photo used as an extra style reference for the
/// AI redesign path in `lib/ai-photo.ts`.
model RefineReference {
  id        String   @id @default(cuid())
  label     String
  mimeType  String
  image     Bytes
  byteSize  Int
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

/// A signed PDF the user chose to keep in their cloud library. The file itself
/// lives in `data`, so uploads are capped and pruned per user (see
/// `lib/signed-documents.ts`) to keep the database from growing unbounded.
model SignedDocument {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName  String
  pageCount Int      @default(1)
  byteSize  Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
